# API server
PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret

# Admin login (created on first server start)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123

# --- Live persistence on Vercel (pick ONE; local dev uses store.json file) ---

# Option A (recommended for SQLite): Turso — free SQLite cloud at https://turso.tech
# Create database → copy Database URL + Auth Token into Vercel env:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Option B: Local SQLite file (development — set USE_SQLITE=true)
USE_SQLITE=false
SQLITE_PATH=server/data/trendkaari.db

# Option C: Upstash Redis — free at https://console.upstash.com
# Create database → REST API → copy URL + token into Vercel env:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option E: GitHub — saves store.json + images into your repo (no Blob)
# Fine-grained token: repo Contents read/write for Trendkaari_clothing
GITHUB_TOKEN=
GITHUB_REPO=TrueTwist-Organization/Trendkaari_clothing
GITHUB_BRANCH=main

# Option F: Vercel Blob (Storage → Blob in Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

# Order confirmation email (required for "Order confirmed" screen; if missing → Technical Error)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=care@trendkaari.com
SITE_NAME=Trendkaari
